{
  "name": "telegram-cdn",
  "version": "1.2.0",
  "description": "HTTP server that streams videos stored in Telegram (private channels / Saved Messages) with Range request support",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && tsc-alias",
    "login": "tsx src/login.ts",
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development nodemon --ext ts,json --exec tsx src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.jest.json",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:int": "jest test/int",
    "test:e2e": "jest -c jest.e2e.config.js",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "big-integer": "^1.6.48",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "input": "^1.0.1",
    "multer": "^2.2.0",
    "p-limit": "3.1.0",
    "teleproto": "^1.228.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/test-sequencer": "^30.4.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.4",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
