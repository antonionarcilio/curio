# Get these at https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated once via `npm run login`, then pasted here
TELEGRAM_SESSION=

# Port the HTTP server listens on
PORT=8787

# Shared secret required as ?token=... on every /video and /list request
ACCESS_TOKEN=change_me

# How long (ms) read results (video/channel listings, video metadata) stay
# cached in memory. Higher = faster repeated requests but staler data (a
# newly sent Telegram video may take this long to show up in listings).
CACHE_TTL_MS=180000

# Max number of chats fetched in parallel by /videos. Higher = faster when
# you have many chats, but raises the risk of hitting Telegram's FLOOD_WAIT.
TELEGRAM_FETCH_CONCURRENCY=5

# Max number of real uploads (to Telegram) running in parallel. Higher =
# faster when uploading multiple videos at once, but raises the risk of
# hitting Telegram's FLOOD_WAIT, same as TELEGRAM_FETCH_CONCURRENCY above.
UPLOAD_CONCURRENCY_LIMIT=1

# How long (minutes) a completed/failed upload job's result stays queryable
# via GET /api/v1/video/upload/progress/:jobId before being cleared from
# memory.
UPLOAD_PROGRESS_TTL_MINUTES=5

# Channel ID `pnpm test:e2e` uses to also exercise list/upload/edit/delete
# against a real channel (not just Saved Messages). The account running the
# e2e tests needs permission to post/delete there. Must include the "-100"
# prefix (a plain positive ID is read as a user, not a channel, by GramJS).
# Only read by test/e2e/helpers/video-fixture.ts, not by the server itself.
SMOKE_TEST_CHANNEL_ID=
