# Get these at https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated once via `npm run login`, then pasted here
TELEGRAM_SESSION=

# Port the HTTP server listens on
PORT=8787

# Shared secret required as ?token=... on every /video and /list request
ACCESS_TOKEN=change-me

# How long (ms) read results (video/channel listings, video metadata) stay
# cached in memory. Higher = faster repeated requests but staler data (a
# newly sent Telegram video may take this long to show up in listings).
CACHE_TTL_MS=180000

# Max number of chats fetched in parallel by /videos. Higher = faster when
# you have many chats, but raises the risk of hitting Telegram's FLOOD_WAIT.
TELEGRAM_FETCH_CONCURRENCY=5
